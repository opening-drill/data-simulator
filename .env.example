# Flask health server
FLASK_PORT=5000

# Redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# Flight tracker
FLIGHT_INTERVAL_SECONDS=3

# Polygon worker API
API_BASE_URL=https://your-api-host/api/polygons
API_KEY=your-api-key-here
POLYGON_INTERVAL_SECONDS=30
POLYGON_EXPIRY_MINUTES=3
TOTAL_MIN_LON=33.50
TOTAL_MAX_LON=35.90
TOTAL_MIN_LAT=29.45
TOTAL_MAX_LAT=33.30

# Flight generator runtime
FLIGHT_GENERATOR_NUM_FLIGHTS=1
FLIGHT_GENERATOR_RUN_INTERVAL_SECONDS=30
FLIGHT_GENERATOR_OUTPUT_JSON_INDENT=2
FLIGHT_GENERATOR_ALLOWED_POINT_MAX_ATTEMPTS=5000
FLIGHT_GENERATOR_UNUSED_EVENT_ID_MAX_ATTEMPTS=1000

# PostgreSQL
FLIGHT_GENERATOR_POSTGRES_HOST=your-postgres-host
FLIGHT_GENERATOR_POSTGRES_PORT=5432
FLIGHT_GENERATOR_POSTGRES_DBNAME=your-database-name
FLIGHT_GENERATOR_POSTGRES_USER=your-database-user
FLIGHT_GENERATOR_POSTGRES_PASSWORD=your-database-password
# Example values: disable, allow, prefer, require, verify-ca, verify-full
FLIGHT_GENERATOR_POSTGRES_SSLMODE=disable
FLIGHT_GENERATOR_POSTGRES_SCHEMA=public
FLIGHT_GENERATOR_POSTGRES_EVENT_TABLE=event
FLIGHT_GENERATOR_POSTGRES_AIRCRAFT_TABLE=aircraft
FLIGHT_GENERATOR_POSTGRES_POLYGON_TABLE=polygon
FLIGHT_GENERATOR_AIRCRAFT_FREE_STATUS=FREE
FLIGHT_GENERATOR_AIRCRAFT_BUSY_STATUS=BUSY

# Dispatch API
FLIGHT_GENERATOR_DISPATCH_URL=https://your-api-host/api/dispatch
FLIGHT_GENERATOR_DISPATCH_TIMEOUT_SECONDS=10
