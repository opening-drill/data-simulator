# --- Redis (used by flight-simulator) ---
REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Flight simulator ---
FLIGHT_INTERVAL_SECONDS=3

# --- Data simulator (polygon API) ---
# Point this at your backend polygons API (no trailing slash on path segment is fine)
API_BASE_URL=https://your-api-host/api/polygons
API_KEY=your-api-key-here

POLYGON_INTERVAL_SECONDS=30
POLYGON_EXPIRY_MINUTES=3

# Optional map bounds (lon/lat)
TOTAL_MIN_LON=33.50
TOTAL_MAX_LON=35.90
TOTAL_MIN_LAT=29.45
TOTAL_MAX_LAT=33.30
