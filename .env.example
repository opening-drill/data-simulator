# Flask health server
FLASK_PORT=5000

# Redis (must match the instance used by your dispatch/live-data service)
# Local docker-compose sets REDIS_HOST=redis automatically.
# On GCloud (Cloud Run / GCE), set REDIS_HOST to your Memorystore or Redis host IP/DNS.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_SSL=false
# REDIS_URL=redis://:password@10.0.0.3:6379/0
# REDIS_CONNECT_TIMEOUT_SECONDS=5
# REDIS_SOCKET_TIMEOUT_SECONDS=5
# REDIS_RETRY_SECONDS=5

# Flight tracker
FLIGHT_INTERVAL_SECONDS=3

# Polygon worker API
API_BASE_URL=https://your-api-host/api/polygons
API_KEY=your-api-key-here
POLYGON_INTERVAL_SECONDS=30
POLYGON_EXPIRY_MINUTES=3
TOTAL_MIN_LON=33.50
TOTAL_MAX_LON=35.90
TOTAL_MIN_LAT=29.45
TOTAL_MAX_LAT=33.30

# Flight generator runtime
FLIGHT_GENERATOR_NUM_FLIGHTS=1
FLIGHT_GENERATOR_RUN_INTERVAL_SECONDS=30
FLIGHT_GENERATOR_OUTPUT_JSON_INDENT=2
FLIGHT_GENERATOR_ALLOWED_POINT_MAX_ATTEMPTS=5000
FLIGHT_GENERATOR_UNUSED_EVENT_ID_MAX_ATTEMPTS=1000

# PostgreSQL
FLIGHT_GENERATOR_POSTGRES_HOST=34.165.129.193
FLIGHT_GENERATOR_POSTGRES_PORT=5432
FLIGHT_GENERATOR_POSTGRES_DBNAME=AIrcraft-NP
FLIGHT_GENERATOR_POSTGRES_USER=postgres
FLIGHT_GENERATOR_POSTGRES_PASSWORD=hashlama020
# Example values: disable, allow, prefer, require, verify-ca, verify-full
FLIGHT_GENERATOR_POSTGRES_SSLMODE=disable
FLIGHT_GENERATOR_POSTGRES_SCHEMA=public
FLIGHT_GENERATOR_POSTGRES_EVENT_TABLE=event
FLIGHT_GENERATOR_POSTGRES_AIRCRAFT_TABLE=aircraft
FLIGHT_GENERATOR_POSTGRES_POLYGON_TABLE=polygon
FLIGHT_GENERATOR_AIRCRAFT_FREE_STATUS=FREE
FLIGHT_GENERATOR_AIRCRAFT_BUSY_STATUS=BUSY

# Dispatch API
FLIGHT_GENERATOR_DISPATCH_URL=https://live-data-1015949672422.europe-west1.run.app/api/dispatch
FLIGHT_GENERATOR_DISPATCH_TIMEOUT_SECONDS=10
